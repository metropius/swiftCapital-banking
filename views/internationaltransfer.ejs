            <main class="flex-1 overflow-y-auto pb-16 md:pb-0">
                <div class="py-6">
                    <div class="max-w-8xl mx-auto px-4 sm:px-6 md:px-8">

                        <div x-data="{
                            withdrawMethod: '',
                            amount: '',
                            transferFrom: 'usd',
                            accountname: '',
                            accountnumber: '',
                            bankname: '',
                            bankaddress: '',
                            Accounttype: 'Checking',
                            country: '',
                            swiftCode: '',
                            iban: '',
                            pin: '',
                            description: '',
                            cryptoCurrency: 'BTC',
                            cryptoNetwork: 'Native',
                            walletAddress: '',
                            paypalEmail: '',
                            wiseFullName: '',
                            wiseEmail: '',
                            wiseCountry: '',
                            skrillEmail: '',
                            skrillFullName: '',
                            venmoUsername: '',
                            venmoPhone: '',
                            zelleEmail: '',
                            zellePhone: '',
                            zelleName: '',
                            cashAppTag: '',
                            cashAppFullName: '',
                            revolutFullName: '',
                            revolutEmail: '',
                            revolutPhone: '',
                            alipayId: '',
                            alipayFullName: '',
                            wechatId: '',
                            wechatName: '',
                            isSubmitting: false,
                            showPreview: false,
                            showMoreMethods: false,

                            get currentBalance() {
                                return this.transferFrom === 'btc' 
                                    ? <%= user.btcBalance || 0 %> 
                                    : <%= user.balance || 0 %>;
                            },

                            validateAmount() {
                                const max = this.currentBalance;
                                if (parseFloat(this.amount) > max) this.amount = max.toString();
                            },

                            changeMethod() {
                                switch(this.withdrawMethod) {
                                    case 'International Wire':
                                        this.formTitle = 'International Wire Transfer';
                                        this.formDescription = 'Funds will reflect in the Beneficiary Account within 72 hours.';
                                        break;
                                    case 'Cryptocurrency':
                                        this.formTitle = 'Cryptocurrency Transfer';
                                        this.formDescription = 'Transfers are typically processed within 1-3 hours.';
                                        break;
                                    case 'PayPal':
                                        this.formTitle = 'PayPal Transfer';
                                        this.formDescription = 'Funds will be sent to your PayPal account within 24 hours.';
                                        break;
                                    case 'Wise Transfer':
                                        this.formTitle = 'Wise Transfer';
                                        this.formDescription = 'Your funds will be processed within 1-2 business days.';
                                        break;
                                    case 'Skrill':
                                        this.formTitle = 'Skrill Transfer';
                                        this.formDescription = 'Withdrawals to Skrill are processed within 24 hours.';
                                        break;
                                    case 'Venmo':
                                        this.formTitle = 'Venmo Transfer';
                                        this.formDescription = 'Funds will be transferred to your Venmo account within 24 hours.';
                                        break;
                                    case 'Zelle':
                                        this.formTitle = 'Zelle Transfer';
                                        this.formDescription = 'Funds will be sent to your Zelle account typically within a few hours.';
                                        break;
                                    case 'Cash App':
                                        this.formTitle = 'Cash App Transfer';
                                        this.formDescription = 'Transfers to Cash App are typically processed within 24 hours.';
                                        break;
                                    case 'Revolut':
                                        this.formTitle = 'Revolut Transfer';
                                        this.formDescription = 'Funds will be transferred to your Revolut account within 1-2 business days.';
                                        break;
                                    case 'Alipay':
                                        this.formTitle = 'Alipay Transfer';
                                        this.formDescription = 'Transfers to Alipay are typically processed within 24-48 hours.';
                                        break;
                                    case 'WeChat Pay':
                                        this.formTitle = 'WeChat Pay Transfer';
                                        this.formDescription = 'Funds will be sent to your WeChat Pay account within 24-48 hours.';
                                        break;
                                    default:
                                        this.formTitle = 'Select Transfer Method';
                                        this.formDescription = 'Choose how you want to send money internationally';
                                }
                            },

                            async submitForm() {
                                if (this.isSubmitting) return;
                                this.isSubmitting = true;

                                const formData = new FormData();
                                formData.append('amount', this.amount);
                                formData.append('transferFrom', this.transferFrom);
                                formData.append('type', this.withdrawMethod);
                                formData.append('pin', this.pin);
                                formData.append('Description', this.description || '');

                                // Common beneficiary fields when applicable
                                if (['International Wire', 'Wise Transfer'].includes(this.withdrawMethod)) {
                                    formData.append('accountname', this.accountname || '');
                                    formData.append('accountnumber', this.accountnumber || '');
                                    formData.append('bankname', this.bankname || '');
                                    formData.append('bank_Address', this.bankaddress || '');
                                    formData.append('bank_iban', this.iban || '');
                                    formData.append('swiftCode', this.swiftCode || '');
                                    formData.append('country', this.country || '');
                                    formData.append('Accounttype', this.Accounttype || '');
                                }

                                // Method-specific fields
                                if (this.withdrawMethod === 'Cryptocurrency') {
                                    formData.append('cryptoCurrency', this.cryptoCurrency);
                                    formData.append('cryptoNetwork', this.cryptoNetwork);
                                    formData.append('walletAddress', this.walletAddress);
                                }
                                if (this.withdrawMethod === 'PayPal') {
                                    formData.append('paypalEmail', this.paypalEmail);
                                }
                                if (this.withdrawMethod === 'Wise Transfer') {
                                    formData.append('wiseFullName', this.wiseFullName);
                                    formData.append('wiseEmail', this.wiseEmail);
                                    formData.append('wiseCountry', this.wiseCountry);
                                }
                                if (this.withdrawMethod === 'Skrill') {
                                    formData.append('skrillEmail', this.skrillEmail);
                                    formData.append('skrillFullName', this.skrillFullName);
                                }
                                if (this.withdrawMethod === 'Venmo') {
                                    formData.append('venmoUsername', this.venmoUsername);
                                    formData.append('venmoPhone', this.venmoPhone);
                                }
                                if (this.withdrawMethod === 'Zelle') {
                                    formData.append('zelleEmail', this.zelleEmail);
                                    formData.append('zellePhone', this.zellePhone);
                                    formData.append('zelleName', this.zelleName);
                                }
                                if (this.withdrawMethod === 'Cash App') {
                                    formData.append('cashAppTag', this.cashAppTag);
                                    formData.append('cashAppFullName', this.cashAppFullName);
                                }
                                if (this.withdrawMethod === 'Revolut') {
                                    formData.append('revolutFullName', this.revolutFullName);
                                    formData.append('revolutEmail', this.revolutEmail);
                                    formData.append('revolutPhone', this.revolutPhone);
                                }
                                if (this.withdrawMethod === 'Alipay') {
                                    formData.append('alipayId', this.alipayId);
                                    formData.append('alipayFullName', this.alipayFullName);
                                }
                                if (this.withdrawMethod === 'WeChat Pay') {
                                    formData.append('wechatId', this.wechatId);
                                    formData.append('wechatName', this.wechatName);
                                }

                                try {
                                    const response = await fetch('/internationaltransfer/<%= user._id %>', {
                                        method: 'POST',
                                        body: formData
                                    });

                                    const result = await response.json();

                                    if (response.ok && result.success) {
                                        Swal.fire({
                                            icon: 'success',
                                            title: 'Transfer Initiated',
                                            text: 'A verification code has been sent to your email.',
                                            timer: 4500,
                                            showConfirmButton: false
                                        }).then(() => {
                                         window.location.href = `/verify-transfer-otp/<%= user._id %>`;
                                        });
                                    } else {
                                        Swal.fire({
                                            icon: 'error',
                                            title: 'Error',
                                            html: result.message || 'Failed to initiate transfer. Please check the form.'
                                        });
                                    }
                                } catch (err) {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Connection Error',
                                        text: 'Could not reach the server. Please check your internet connection.'
                                    });
                                } finally {
                                    this.isSubmitting = false;
                                }
                            }
                        }">

                            <div class="flex flex-col mb-6">
                                <h1 class="text-2xl font-bold text-gray-900 mb-1">International Transfer</h1>
                                <div class="flex items-center text-sm text-gray-500">
                                    <a href="/dashboard" class="hover:text-primary-600">Dashboard</a>
                                    <i data-lucide="chevron-right" class="h-4 w-4 mx-2"></i>
                                    <span class="font-medium text-gray-700">International Transfer</span>
                                </div>
                            </div>

                            <div class="max-w-4xl mx-auto">
                                <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden">
                                    <div class="relative bg-gradient-to-r from-primary-600 to-primary-700 px-6 py-8 text-center">
                                        <div class="flex flex-col items-center">
                                            <div class="bg-white/20 backdrop-blur-sm p-4 rounded-full mb-4">
                                                <i data-lucide="globe" class="h-10 w-10 text-white"></i>
                                            </div>
                                            <h2 class="text-2xl font-bold text-white" x-text="withdrawMethod ? withdrawMethod + ' Transfer' : 'International Transfer'"></h2>
                                            <p class="text-white/80 mt-1" x-text="withdrawMethod ? 'Secure international money transfer' : 'Choose your preferred transfer method'"></p>
                                        </div>
                                    </div>

                                    <div class="p-6 md:p-8">

                                        <!-- Balance selector -->
                                        <div class="bg-gradient-to-br from-blue-50 to-white p-4 rounded-xl border border-blue-100 mb-6 shadow-sm">
                                            <div class="flex items-center justify-between">
                                                <div class="flex items-center">
                                                    <div class="w-10 h-10 rounded-full flex items-center justify-center bg-blue-100 mr-3">
                                                        <i data-lucide="wallet" class="h-5 w-5 text-blue-600"></i>
                                                    </div>
                                                    <div>
                                                        <p class="text-sm text-gray-500">Available Balance</p>
                                                        <p class="text-xl font-bold text-gray-900">
                                                            <span x-text="transferFrom === 'usd' ? '<%= user.currency %>' : 'BTC'"></span>
                                                            <span x-text="currentBalance.toFixed(transferFrom === 'btc' ? 8 : 2)"></span>
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="flex items-center gap-2">
                                                    <label class="text-sm text-gray-600">Source:</label>
                                                    <select x-model="transferFrom" class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500">
                                                        <option value="usd">USD</option>
                                                        <option value="btc">BTC</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Amount -->
                                        <div class="mb-8 bg-gradient-to-br from-gray-50 to-white p-5 rounded-xl border border-gray-100 shadow-sm">
                                            <label class="block text-sm font-medium text-gray-700 mb-2">Amount to Send</label>
                                            <div class="relative">
                                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                                    <span class="text-gray-500 text-lg font-bold" x-text="transferFrom === 'usd' ? '<%= user.currency %>' : '₿'"></span>
                                                </div>
                                                <input 
                                                    type="number"
                                                    x-model="amount"
                                                    @input="validateAmount()"
                                                    min="0.01"
                                                    :max="currentBalance"
                                                    step="any"
                                                    class="block w-full pl-12 pr-20 py-4 border-2 border-primary-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-2xl font-bold"
                                                    placeholder="0.00"
                                                    required
                                                />
                                                <div class="absolute right-3 top-1/2 transform -translate-y-1/2 text-lg font-bold text-gray-400 pointer-events-none">
                                                    .00
                                                </div>
                                            </div>

                                            <div class="mt-4 flex flex-wrap gap-2">
                                                <button type="button" @click="amount = '100'" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-md text-sm font-medium text-gray-700 transition-colors">$100</button>
                                                <button type="button" @click="amount = '500'" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-md text-sm font-medium text-gray-700 transition-colors">$500</button>
                                                <button type="button" @click="amount = '1000'" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-md text-sm font-medium text-gray-700 transition-colors">$1000</button>
                                                <button type="button" @click="amount = currentBalance.toString()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-md text-sm font-medium text-gray-700 transition-colors">Max</button>
                                            </div>
                                        </div>

                                        <!-- Method selection grid -->
                                        <div x-show="!withdrawMethod && !showMoreMethods" class="mb-8">
                                            <h2 class="text-xl font-bold text-gray-900 mb-4">Select Transfer Method</h2>
                                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

                                                <div @click="withdrawMethod = 'International Wire'; changeMethod()" class="cursor-pointer bg-white rounded-xl border border-gray-200 p-4 hover:border-primary-500 hover:shadow-md transition-all">
                                                    <div class="flex items-center mb-3">
                                                        <div class="h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center">
                                                            <i data-lucide="landmark" class="h-5 w-5 text-blue-600"></i>
                                                        </div>
                                                        <h3 class="ml-3 font-medium text-gray-900">International Wire</h3>
                                                    </div>
                                                    <p class="text-sm text-gray-500">Bank wire to any country</p>
                                                </div>

                                                <div @click="withdrawMethod = 'Cryptocurrency'; changeMethod()" class="cursor-pointer bg-white rounded-xl border border-gray-200 p-4 hover:border-primary-500 hover:shadow-md transition-all">
                                                    <div class="flex items-center mb-3">
                                                        <div class="h-10 w-10 rounded-full bg-purple-100 flex items-center justify-center">
                                                            <i data-lucide="bitcoin" class="h-5 w-5 text-purple-600"></i>
                                                        </div>
                                                        <h3 class="ml-3 font-medium text-gray-900">Cryptocurrency</h3>
                                                    </div>
                                                    <p class="text-sm text-gray-500">Send to crypto wallet</p>
                                                </div>

                                                <div @click="withdrawMethod = 'PayPal'; changeMethod()" class="cursor-pointer bg-white rounded-xl border border-gray-200 p-4 hover:border-primary-500 hover:shadow-md transition-all">
                                                    <div class="flex items-center mb-3">
                                                        <div class="h-10 w-10 rounded-full bg-indigo-100 flex items-center justify-center">
                                                            <i data-lucide="credit-card" class="h-5 w-5 text-indigo-600"></i>
                                                        </div>
                                                        <h3 class="ml-3 font-medium text-gray-900">PayPal</h3>
                                                    </div>
                                                    <p class="text-sm text-gray-500">Instant to PayPal account</p>
                                                </div>

                                                <div @click="withdrawMethod = 'Wise Transfer'; changeMethod()" class="cursor-pointer bg-white rounded-xl border border-gray-200 p-4 hover:border-primary-500 hover:shadow-md transition-all">
                                                    <div class="flex items-center mb-3">
                                                        <div class="h-10 w-10 rounded-full bg-green-100 flex items-center justify-center">
                                                            <i data-lucide="send" class="h-5 w-5 text-green-600"></i>
                                                        </div>
                                                        <h3 class="ml-3 font-medium text-gray-900">Wise</h3>
                                                    </div>
                                                    <p class="text-sm text-gray-500">Low-fee international transfer</p>
                                                </div>

                                                <div @click="withdrawMethod = 'Skrill'; changeMethod()" class="cursor-pointer bg-white rounded-xl border border-gray-200 p-4 hover:border-primary-500 hover:shadow-md transition-all">
                                                    <div class="flex items-center mb-3">
                                                        <div class="h-10 w-10 rounded-full bg-indigo-100 flex items-center justify-center">
                                                            <i data-lucide="credit-card" class="h-5 w-5 text-indigo-600"></i>
                                                        </div>
                                                        <h3 class="ml-3 font-medium text-gray-900">Skrill</h3>
                                                    </div>
                                                    <p class="text-sm text-gray-500">Fast digital wallet transfer</p>
                                                </div>

                                                <div @click="withdrawMethod = 'Venmo'; changeMethod()" class="cursor-pointer bg-white rounded-xl border border-gray-200 p-4 hover:border-primary-500 hover:shadow-md transition-all">
                                                    <div class="flex items-center mb-3">
                                                        <div class="h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center">
                                                            <i data-lucide="send" class="h-5 w-5 text-blue-600"></i>
                                                        </div>
                                                        <h3 class="ml-3 font-medium text-gray-900">Venmo</h3>
                                                    </div>
                                                    <p class="text-sm text-gray-500">Quick US peer-to-peer</p>
                                                </div>

                                                <div @click="withdrawMethod = 'Zelle'; changeMethod()" class="cursor-pointer bg-white rounded-xl border border-gray-200 p-4 hover:border-primary-500 hover:shadow-md transition-all">
                                                    <div class="flex items-center mb-3">
                                                        <div class="h-10 w-10 rounded-full bg-purple-100 flex items-center justify-center">
                                                            <i data-lucide="zap" class="h-5 w-5 text-purple-600"></i>
                                                        </div>
                                                        <h3 class="ml-3 font-medium text-gray-900">Zelle</h3>
                                                    </div>
                                                    <p class="text-sm text-gray-500">Instant bank-to-bank US</p>
                                                </div>

                                                <div @click="withdrawMethod = 'Cash App'; changeMethod()" class="cursor-pointer bg-white rounded-xl border border-gray-200 p-4 hover:border-primary-500 hover:shadow-md transition-all">
                                                    <div class="flex items-center mb-3">
                                                        <div class="h-10 w-10 rounded-full bg-pink-100 flex items-center justify-center">
                                                            <i data-lucide="dollar-sign" class="h-5 w-5 text-pink-600"></i>
                                                        </div>
                                                        <h3 class="ml-3 font-medium text-gray-900">Cash App</h3>
                                                    </div>
                                                    <p class="text-sm text-gray-500">Fast US mobile transfer</p>
                                                </div>

                                                <div @click="withdrawMethod = 'Revolut'; changeMethod()" class="cursor-pointer bg-white rounded-xl border border-gray-200 p-4 hover:border-primary-500 hover:shadow-md transition-all">
                                                    <div class="flex items-center mb-3">
                                                        <div class="h-10 w-10 rounded-full bg-cyan-100 flex items-center justify-center">
                                                            <i data-lucide="credit-card" class="h-5 w-5 text-cyan-600"></i>
                                                        </div>
                                                        <h3 class="ml-3 font-medium text-gray-900">Revolut</h3>
                                                    </div>
                                                    <p class="text-sm text-gray-500">Borderless account transfer</p>
                                                </div>

                                                <div @click="withdrawMethod = 'Alipay'; changeMethod()" class="cursor-pointer bg-white rounded-xl border border-gray-200 p-4 hover:border-primary-500 hover:shadow-md transition-all">
                                                    <div class="flex items-center mb-3">
                                                        <div class="h-10 w-10 rounded-full bg-red-100 flex items-center justify-center">
                                                            <i data-lucide="credit-card" class="h-5 w-5 text-red-600"></i>
                                                        </div>
                                                        <h3 class="ml-3 font-medium text-gray-900">Alipay</h3>
                                                    </div>
                                                    <p class="text-sm text-gray-500">Popular in China</p>
                                                </div>

                                                <div @click="withdrawMethod = 'WeChat Pay'; changeMethod()" class="cursor-pointer bg-white rounded-xl border border-gray-200 p-4 hover:border-primary-500 hover:shadow-md transition-all">
                                                    <div class="flex items-center mb-3">
                                                        <div class="h-10 w-10 rounded-full bg-green-100 flex items-center justify-center">
                                                            <i data-lucide="wechat" class="h-5 w-5 text-green-600"></i>
                                                        </div>
                                                        <h3 class="ml-3 font-medium text-gray-900">WeChat Pay</h3>
                                                    </div>
                                                    <p class="text-sm text-gray-500">Widely used in China</p>
                                                </div>

                                            </div>
                                        </div>

                                        <!-- Method-specific form fields -->
                                        <div x-show="withdrawMethod" class="space-y-6">

                                            <!-- International Wire -->
                                            <div x-show="withdrawMethod === 'International Wire'" class="space-y-6">
                                                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                                    <div>
                                                        <label class="block text-sm font-medium text-gray-700 mb-1">Account Name</label>
                                                        <input type="text" x-model="accountname" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Beneficiary full name" />
                                                    </div>
                                                    <div>
                                                        <label class="block text-sm font-medium text-gray-700 mb-1">Account Number</label>
                                                        <input type="text" x-model="accountnumber" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="IBAN / Account #" />
                                                    </div>
                                                </div>
                                                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                                    <div>
                                                        <label class="block text-sm font-medium text-gray-700 mb-1">Bank Name</label>
                                                        <input type="text" x-model="bankname" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Bank name" />
                                                    </div>
                                                    <div>
                                                        <label class="block text-sm font-medium text-gray-700 mb-1">Bank Address</label>
                                                        <input type="text" x-model="bankaddress" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Bank full address" />
                                                    </div>
                                                </div>
                                                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                                                    <div>
                                                        <label class="block text-sm font-medium text-gray-700 mb-1">Country</label>
                                                        <input type="text" x-model="country" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Country" />
                                                    </div>
                                                    <div>
                                                        <label class="block text-sm font-medium text-gray-700 mb-1">SWIFT / BIC</label>
                                                        <input type="text" x-model="swiftCode" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="SWIFT code" />
                                                    </div>
                                                    <div>
                                                        <label class="block text-sm font-medium text-gray-700 mb-1">IBAN</label>
                                                        <input type="text" x-model="iban" class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="IBAN (if applicable)" />
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Cryptocurrency -->
                                            <div x-show="withdrawMethod === 'Cryptocurrency'" class="space-y-6">
                                                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                                    <div>
                                                        <label class="block text-sm font-medium text-gray-700 mb-1">Cryptocurrency</label>
                                                        <select x-model="cryptoCurrency" class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500">
                                                            <option value="BTC">Bitcoin (BTC)</option>
                                                            <option value="ETH">Ethereum (ETH)</option>
                                                            <option value="USDT">Tether (USDT)</option>
                                                            <option value="BNB">Binance Coin (BNB)</option>
                                                            <option value="XRP">Ripple (XRP)</option>
                                                        </select>
                                                    </div>
                                                    <div>
                                                        <label class="block text-sm font-medium text-gray-700 mb-1">Network</label>
                                                        <select x-model="cryptoNetwork" class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500">
                                                            <option value="Native">Native</option>
                                                            <option value="ERC20">ERC-20</option>
                                                            <option value="BEP20">BEP-20</option>
                                                            <option value="TRC20">TRC-20</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Wallet Address</label>
                                                    <input type="text" x-model="walletAddress" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500 font-mono" placeholder="Enter recipient wallet address" />
                                                </div>
                                            </div>

                                            <!-- PayPal -->
                                            <div x-show="withdrawMethod === 'PayPal'" class="space-y-6">
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">PayPal Email</label>
                                                    <input type="email" x-model="paypalEmail" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="paypal@example.com" />
                                                </div>
                                            </div>

                                            <!-- Wise -->
                                            <div x-show="withdrawMethod === 'Wise Transfer'" class="space-y-6">
                                                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                                    <div>
                                                        <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                                                        <input type="text" x-model="wiseFullName" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Full name on Wise account" />
                                                    </div>
                                                    <div>
                                                        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                                                        <input type="email" x-model="wiseEmail" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Email linked to Wise" />
                                                    </div>
                                                </div>
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Country</label>
                                                    <input type="text" x-model="wiseCountry" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Country of Wise account" />
                                                </div>
                                            </div>

                                            <!-- Skrill -->
                                            <div x-show="withdrawMethod === 'Skrill'" class="space-y-6">
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Skrill Email</label>
                                                    <input type="email" x-model="skrillEmail" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="skrill@example.com" />
                                                </div>
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                                                    <input type="text" x-model="skrillFullName" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Name on Skrill account" />
                                                </div>
                                            </div>

                                            <!-- Venmo -->
                                            <div x-show="withdrawMethod === 'Venmo'" class="space-y-6">
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Venmo Username</label>
                                                    <input type="text" x-model="venmoUsername" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="@username" />
                                                </div>
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                                                    <input type="tel" x-model="venmoPhone" class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="+1 (555) 123-4567" />
                                                </div>
                                            </div>

                                            <!-- Zelle -->
                                            <div x-show="withdrawMethod === 'Zelle'" class="space-y-6">
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Zelle Email or Phone</label>
                                                    <input type="text" x-model="zelleEmail || zellePhone" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="email or phone" />
                                                </div>
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                                                    <input type="text" x-model="zelleName" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Name on Zelle" />
                                                </div>
                                            </div>

                                            <!-- Cash App -->
                                            <div x-show="withdrawMethod === 'Cash App'" class="space-y-6">
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">$Cashtag</label>
                                                    <input type="text" x-model="cashAppTag" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="$cashtag" />
                                                </div>
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                                                    <input type="text" x-model="cashAppFullName" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Name on Cash App" />
                                                </div>
                                            </div>

                                            <!-- Revolut -->
                                            <div x-show="withdrawMethod === 'Revolut'" class="space-y-6">
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                                                    <input type="text" x-model="revolutFullName" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Full name on Revolut" />
                                                </div>
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Email or Phone</label>
                                                    <input type="text" x-model="revolutEmail || revolutPhone" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Email or phone linked to Revolut" />
                                                </div>
                                            </div>

                                            <!-- Alipay -->
                                            <div x-show="withdrawMethod === 'Alipay'" class="space-y-6">
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Alipay ID</label>
                                                    <input type="text" x-model="alipayId" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Alipay ID / Email / Phone" />
                                                </div>
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                                                    <input type="text" x-model="alipayFullName" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Name on Alipay" />
                                                </div>
                                            </div>

                                            <!-- WeChat Pay -->
                                            <div x-show="withdrawMethod === 'WeChat Pay'" class="space-y-6">
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">WeChat ID</label>
                                                    <input type="text" x-model="wechatId" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="WeChat ID / Phone" />
                                                </div>
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                                                    <input type="text" x-model="wechatName" required class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Name on WeChat Pay" />
                                                </div>
                                            </div>

                                            <!-- Common fields: PIN + Note -->
                                            <div class="space-y-6 mt-8">
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Transaction PIN</label>
                                                    <div class="relative">
                                                        <input 
                                                            type="password" 
                                                            x-model="pin" 
                                                            required 
                                                            class="block w-full pl-10 pr-10 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500"
                                                            placeholder="Enter your PIN"
                                                        />
                                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                                            <i data-lucide="lock" class="h-5 w-5 text-gray-400"></i>
                                                        </div>
                                                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
                                                            <button type="button" class="text-gray-400" @click="$el.parentElement.previousElementSibling.type = $el.parentElement.previousElementSibling.type === 'password' ? 'text' : 'password'">
                                                                <i data-lucide="eye" x-show="$el.parentElement.previousElementSibling.type === 'password'"></i>
                                                                <i data-lucide="eye-off" x-show="$el.parentElement.previousElementSibling.type !== 'password'"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-1">Note (optional)</label>
                                                    <textarea x-model="description" rows="3" class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Add a note or reference"></textarea>
                                                </div>
                                            </div>

                                            <!-- Action buttons -->
                                            <div class="flex flex-col sm:flex-row gap-4 mt-8">
                                                <button 
                                                    type="button"
                                                    @click="showPreview = true"
                                                    :disabled="isSubmitting || !amount || !withdrawMethod"
                                                    class="flex-1 py-4 bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                                                >
                                                    Review & Confirm Transfer
                                                </button>
                                                <button 
                                                    type="button"
                                                    @click="withdrawMethod = ''; showMoreMethods = false"
                                                    class="flex-1 py-4 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors"
                                                >
                                                    Change Method
                                                </button>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <!-- Preview Modal -->
                                <div x-show="showPreview" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-60" @click="showPreview = false">
                                    <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full mx-4 overflow-hidden" @click.stop>
                                        <div class="bg-gradient-to-r from-primary-600 to-primary-700 px-6 py-8 text-center text-white">
                                            <h3 class="text-2xl font-bold">Confirm Transfer</h3>
                                            <p class="mt-2 text-white/90">Please review details below</p>
                                        </div>

                                        <div class="p-6 space-y-4">
                                            <div class="flex justify-between">
                                                <span class="text-gray-600">Method</span>
                                                <span class="font-medium" x-text="withdrawMethod"></span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span class="text-gray-600">Source</span>
                                                <span class="font-medium" x-text="transferFrom.toUpperCase()"></span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span class="text-gray-600">Amount</span>
                                                <span class="font-bold text-xl" x-text="transferFrom === 'usd' ? '<%= user.currency %>' + parseFloat(amount).toFixed(2) : '₿' + parseFloat(amount).toFixed(8)"></span>
                                            </div>

                                            <!-- Method-specific preview lines -->
                                            <template x-if="withdrawMethod === 'International Wire'">
                                                <div class="pt-4 border-t">
                                                    <div class="flex justify-between"><span class="text-gray-600">Account Name</span><span x-text="accountname || '-'"></span></div>
                                                    <div class="flex justify-between"><span class="text-gray-600">Account Number</span><span x-text="accountnumber || '-'"></span></div>
                                                    <div class="flex justify-between"><span class="text-gray-600">Bank</span><span x-text="bankname || '-'"></span></div>
                                                    <div class="flex justify-between"><span class="text-gray-600">Country</span><span x-text="country || '-'"></span></div>
                                                </div>
                                            </template>

                                            <template x-if="withdrawMethod === 'Cryptocurrency'">
                                                <div class="pt-4 border-t">
                                                    <div class="flex justify-between"><span class="text-gray-600">Coin / Network</span><span x-text="cryptoCurrency + ' (' + cryptoNetwork + ')'"></span></div>
                                                    <div class="flex justify-between"><span class="text-gray-600">Wallet</span><span class="font-mono text-sm break-all" x-text="walletAddress || '-'"></span></div>
                                                </div>
                                            </template>

                                            <template x-if="withdrawMethod === 'PayPal'">
                                                <div class="pt-4 border-t">
                                                    <div class="flex justify-between"><span class="text-gray-600">PayPal Email</span><span x-text="paypalEmail || '-'"></span></div>
                                                </div>
                                            </template>

                                            <template x-if="withdrawMethod === 'Wise Transfer'">
                                                <div class="pt-4 border-t">
                                                    <div class="flex justify-between"><span class="text-gray-600">Name</span><span x-text="wiseFullName || '-'"></span></div>
                                                    <div class="flex justify-between"><span class="text-gray-600">Email</span><span x-text="wiseEmail || '-'"></span></div>
                                                    <div class="flex justify-between"><span class="text-gray-600">Country</span><span x-text="wiseCountry || '-'"></span></div>
                                                </div>
                                            </template>

                                            <!-- ... similar template blocks for Skrill, Venmo, Zelle, Cash App, Revolut, Alipay, WeChat Pay ... -->

                                            <div class="pt-4 border-t font-bold text-lg flex justify-between">
                                                <span>Total Sent</span>
                                                <span x-text="transferFrom === 'usd' ? '<%= user.currency %>' + parseFloat(amount).toFixed(2) : '₿' + parseFloat(amount).toFixed(8)"></span>
                                            </div>
                                        </div>

                                        <div class="px-6 py-4 bg-gray-50 flex flex-col sm:flex-row gap-3">
                                           <button 
    type="button" 
    @click="submitForm()"
    class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-primary-600 text-base font-medium text-white hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 sm:ml-3 sm:w-auto sm:text-sm"
    :disabled="isSubmitting"
>
    <span x-show="!isSubmitting">Confirm Transfer</span>
    <span x-show="isSubmitting" class="flex items-center">
        <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white" ...></svg>
        Processing...
    </span>
</button>
                                            <button @click="showPreview = false" class="flex-1 py-3 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors" :disabled="isSubmitting">
                                                Cancel
                                            </button>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>
                </div>
            </main>

            <footer class="bg-white border-t border-gray-200 hidden md:block">
                <div class="max-w-7xl mx-auto py-4 px-4 sm:px-6 md:flex md:items-center md:justify-between">
                    <div class="flex items-center">
                        <img src="storage/app/public/photos/I98wEMilPMHkNy8wxBtJ86dmMTWl2kK4kkPJNI9l.png" alt="Logo" class="h-6 w-auto mr-2">
                        <p class="text-sm text-gray-500">© 2026 swiftcaptial. All rights reserved.</p>
                    </div>
                    <div class="flex space-x-6 mt-4 md:mt-0">
                        <a href="#" class="text-sm text-gray-500 hover:text-gray-700">Privacy Policy</a>
                        <a href="#" class="text-sm text-gray-500 hover:text-gray-700">Terms of Service</a>
                        <a href="/support" class="text-sm text-gray-500 hover:text-gray-700">Contact Support</a>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script>
        lucide.createIcons();

        window.addEventListener('load', function() {
            const preloader = document.querySelector('.page-loading');
            setTimeout(() => {
                preloader.classList.remove('active');
                setTimeout(() => preloader.remove(), 500);
            }, 800);
        });
    </script>

      <script>
document.getElementById('current-date').textContent = 
    new Date().toLocaleDateString('en-US', { 
        weekday: 'long', 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric' 
    });
</script>

</body>
</html>