                        <p class="text-sm text-gray-500">© 2026 swiftcaptial. All rights reserved.</p>
                    </div>
                    <div class="flex space-x-6 mt-4 md:mt-0">
                        <a href="#" class="text-sm text-gray-500 hover:text-gray-700">Privacy Policy</a>
                        <a href="#" class="text-sm text-gray-500 hover:text-gray-700">Terms of Service</a>
                        <a href="/support" class="text-sm text-gray-500 hover:text-gray-700">Contact Support</a>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        lucide.createIcons();

        // Date and Time Updates
        function updateDate() {
            document.getElementById('current-date').textContent = 
    new Date().toLocaleDateString('en-US', { 
        weekday: 'long', 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric' 
    });
        }
        updateDate();
      

        // Password Change AJAX with SweetAlert
        document.getElementById('changePasswordForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();

            const form = this;
            const submitBtn = form.querySelector('button[type="submit"]');
            const current = form.querySelector('#current_password').value.trim();
            const newPass = form.querySelector('#password').value.trim();
            const confirmPass = form.querySelector('#password_confirmation').value.trim();

            // Client-side validation
            if (!current) {
                return Swal.fire({
                    icon: 'warning',
                    title: 'Missing Field',
                    text: 'Please enter your current password',
                });
            }

            if (!newPass || newPass.length < 8) {
                return Swal.fire({
                    icon: 'warning',
                    title: 'Weak Password',
                    text: 'New password must be at least 8 characters long',
                });
            }

            if (newPass !== confirmPass) {
                return Swal.fire({
                    icon: 'error',
                    title: 'Password Mismatch',
                    text: 'New password and confirmation do not match',
                });
            }

            // Disable button during request
            submitBtn.disabled = true;
            submitBtn.querySelector('span').textContent = 'Changing...';

            const formData = new FormData(form);
            const data = Object.fromEntries(formData);

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: result.message || 'Password changed successfully!',
                        timer: 2500,
                        showConfirmButton: false
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: result.message || 'Failed to change password. Please try again.'
                    });
                }
            } catch (err) {
                Swal.fire({
                    icon: 'error',
                    title: 'Network Error',
                    text: 'Could not connect to the server. Please check your connection.'
                });
            } finally {
                submitBtn.disabled = false;
                submitBtn.querySelector('span').textContent = 'Change Password';
            }
        });

        // Hide loader
        window.addEventListener('load', function() {
            const loader = document.querySelector('.page-loading');
            if (loader) {
                setTimeout(() => {
                    loader.classList.remove('active');
                    setTimeout(() => loader.remove(), 600);
                }, 800);
            }
        });
    </script>
    
