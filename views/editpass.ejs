                                                        type="button"
                                                        @click="showCurrent = !showCurrent"
                                                        class="text-gray-400 hover:text-primary-600 focus:outline-none"
                                                    >
                                                        <i x-show="!showCurrent" data-lucide="eye" class="h-5 w-5"></i>
