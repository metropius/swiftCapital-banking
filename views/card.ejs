                                <div class="h-10 w-10 rounded-full bg-white flex items-center justify-center mb-1 shadow-sm group-hover:shadow transition-all">
                                    <i data-lucide="credit-card" class="h-5 w-5 text-secondary-600"></i>
                                </div>
                                <span class="text-xs font-medium text-gray-700">Loan</span>
                            </div>
                        </a>
                        <a href="/irs-refund" class="group">
                            <div class="aspect-square flex flex-col items-center justify-center rounded-xl bg-gradient-to-br from-primary-50 to-primary-100 hover:from-primary-100 hover:to-primary-200 transition-all duration-300 p-2">
                                <div class="h-10 w-10 rounded-full bg-white flex items-center justify-center mb-1 shadow-sm group-hover:shadow transition-all">
                                    <i data-lucide="receipt" class="h-5 w-5 text-black"></i>
                                </div>
                                <span class="text-xs font-medium text-gray-700">IRS Refund</span>
                            </div>
                        </a>
                        <a href="/account-settings" class="group">
                            <div class="aspect-square flex flex-col items-center justify-center rounded-xl bg-gradient-to-br from-primary-50 to-primary-100 hover:from-primary-100 hover:to-primary-200 transition-all duration-300 p-2">
                                <div class="h-10 w-10 rounded-full bg-white flex items-center justify-center mb-1 shadow-sm group-hover:shadow transition-all">
                                    <i data-lucide="settings" class="h-5 w-5 text-black"></i>
                                </div>
                                <span class="text-xs font-medium text-gray-700">Settings</span>
                            </div>
                        </a>
                        <a href="/support" class="group">
                            <div class="aspect-square flex flex-col items-center justify-center rounded-xl bg-gradient-to-br from-secondary-50 to-secondary-100 hover:from-secondary-100 hover:to-secondary-200 transition-all duration-300 p-2">
                                <div class="h-10 w-10 rounded-full bg-white flex items-center justify-center mb-1 shadow-sm group-hover:shadow transition-all">
                                    <i data-lucide="help-circle" class="h-5 w-5 text-secondary-600"></i>
                                </div>
                                <span class="text-xs font-medium text-gray-700">Support</span>
                            </div>
                        </a>
                        <a href="/logout" class="group">
                            <div class="aspect-square flex flex-col items-center justify-center rounded-xl bg-gradient-to-br from-accent-50 to-accent-100 hover:from-accent-100 hover:to-accent-200 transition-all duration-300 p-2">
                                <div class="h-10 w-10 rounded-full bg-white flex items-center justify-center mb-1 shadow-sm group-hover:shadow transition-all">
                                    <i data-lucide="log-out" class="h-5 w-5 text-accent-600"></i>
                                </div>
                                <span class="text-xs font-medium text-gray-700">Logout</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Mobile Bottom Navigation -->
            <div class="fixed bottom-0 left-0 right-0 md:hidden z-30">
                <div class="bg-white border-t border-gray-200 shadow-lg rounded-t-3xl mx-2 mb-1">
                    <div class="flex justify-between items-center px-6 py-3 relative">
                        <a href="/dashboard" class="flex flex-col items-center">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center">
                                <i data-lucide="home" class="h-5 w-5 text-gray-500"></i>
                            </div>
                            <span class="text-xs font-medium text-gray-500">Home</span>
                        </a>
                        <a href="/accounthistory/<%= user._id %>" class="flex flex-col items-center">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center">
                                <i data-lucide="bar-chart-2" class="h-5 w-5 text-gray-500"></i>
                            </div>
                            <span class="text-xs font-medium text-gray-500">Stats</span>
                        </a>
                        <div class="absolute left-1/2 transform -translate-x-1/2 -translate-y-1/2 top-0">
                            <button 
                                @click="mobileMenuOpen = true" 
                                class="bg-gradient-to-r from-primary-600 to-primary-800 w-16 h-16 rounded-full flex items-center justify-center shadow-lg border-4 border-white">
                                <i data-lucide="grid" class="h-8 w-8 text-white"></i>
                            </button>
                        </div>
                        <a href="/cards" class="flex flex-col items-center">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center">
                                <i data-lucide="credit-card" class="h-5 w-5 text-gray-500"></i>
                            </div>
                            <span class="text-xs font-medium text-gray-500">Cards</span>
                        </a>
                        <a href="/account-settings" class="flex flex-col items-center">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center">
                                <i data-lucide="user" class="h-5 w-5 text-gray-500"></i>
                            </div>
                            <span class="text-xs font-medium text-gray-500">Profile</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <main class="flex-1 overflow-y-auto pb-16 md:pb-0">
                <div class="py-6">
                    <div class="max-w-8xl mx-auto px-4 sm:px-6 md:px-8">

                        <!-- Breadcrumbs + Title -->
                        <div class="mb-6">
                            <div class="flex items-center justify-between flex-wrap gap-4">
                                <div>
                                    <div class="flex items-center text-sm text-gray-500">
                                        <a href="/dashboard" class="hover:text-primary-600">Dashboard</a>
                                        <i data-lucide="chevron-right" class="h-4 w-4 mx-2"></i>
                                        <span class="font-medium text-gray-700">Cards</span>
                                    </div>
                                    <h1 class="text-2xl font-bold text-gray-900 mt-1">Virtual Cards</h1>
                                </div>

                                <% if (stats.pendingCount === 0 && stats.activeCount === 0) { %>
                                    <a href="/apply" class="inline-flex items-center px-5 py-2.5 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition">
                                        <i data-lucide="plus" class="h-4 w-4 mr-2"></i> Apply for Card
                                    </a>
                                <% } else { %>
                                    <button disabled class="inline-flex items-center px-5 py-2.5 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-600 bg-gray-100 cursor-not-allowed">
                                        <i data-lucide="clock" class="h-4 w-4 mr-2"></i>
                                        <%= stats.pendingCount > 0 ? 'Application Pending' : 'Card Active' %>
                                    </button>
                                <% } %>
                            </div>
                        </div>

                        <!-- Statistics Cards -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-8">
                            <!-- Active Cards -->
                            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden hover:shadow transition-shadow">
                                <div class="p-6">
                                    <div class="flex items-center">
                                        <div class="flex-shrink-0 bg-green-100 rounded-full p-3">
                                            <i data-lucide="credit-card" class="h-6 w-6 text-green-600"></i>
                                        </div>
                                        <div class="ml-4">
                                            <p class="text-sm font-medium text-gray-500">Active Cards</p>
                                            <p class="text-3xl font-bold text-gray-900 mt-1"><%= stats.activeCount %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Pending Applications -->
                            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden hover:shadow transition-shadow">
                                <div class="p-6">
                                    <div class="flex items-center">
                                        <div class="flex-shrink-0 bg-yellow-100 rounded-full p-3">
                                            <i data-lucide="clock" class="h-6 w-6 text-yellow-600"></i>
                                        </div>
                                        <div class="ml-4">
                                            <p class="text-sm font-medium text-gray-500">Pending Applications</p>
                                            <p class="text-3xl font-bold text-gray-900 mt-1"><%= stats.pendingCount %></p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Total Card Balance + Swap -->
                            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden hover:shadow transition-shadow">
                                <div class="p-6">
                                    <div class="flex items-center justify-between flex-wrap gap-4">
                                        <div class="flex items-center">
                                            <div class="flex-shrink-0 bg-blue-100 rounded-full p-3">
                                                <i data-lucide="wallet" class="h-6 w-6 text-blue-600"></i>
                                            </div>
                                            <div class="ml-4">
                                                <p class="text-sm font-medium text-gray-500">Total Card Balance</p>
                                                <p class="text-3xl font-bold text-gray-900 mt-1">
                                                    <%= user.currency %> <%= stats.totalCardBalance %>
                                                </p>
                                            </div>
                                        </div>

                                        <% if (parseFloat(stats.totalCardBalance) > 0) { %>
                                            <button 
                                                onclick="swapBalance()"
                                                class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition">
                                                <i data-lucide="refresh-cw" class="h-4 w-4 mr-2"></i> Swap to Main
                                            </button>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card Listings / No Cards -->
                        <% if (cards.length === 0) { %>
                            <div class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-100 mb-8">
                                <div class="border-b border-gray-200 px-6 py-4">
                                    <h2 class="text-lg font-medium text-gray-900">Your Cards</h2>
                                </div>
                                <div class="p-12 text-center">
                                    <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-gray-100 mb-4">
                                        <i data-lucide="credit-card" class="h-8 w-8 text-gray-400"></i>
                                    </div>
                                    <h3 class="text-xl font-medium text-gray-900 mb-2">No cards yet</h3>
                                    <p class="text-gray-600 mb-6 max-w-md mx-auto">
                                        You haven't applied for any virtual cards yet. Apply now to get started with secure online payments.
                                    </p>
                                    <% if (stats.pendingCount === 0 && stats.activeCount === 0) { %>
                                        <a href="/apply" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-primary-600 hover:bg-primary-700">
                                            Apply for Card
                                        </a>
                                    <% } else { %>
                                        <button disabled class="inline-flex items-center px-6 py-3 border border-gray-300 text-base font-medium rounded-md shadow-sm text-gray-600 bg-gray-100 cursor-not-allowed">
                                            Application <%= stats.pendingCount > 0 ? 'Pending' : 'Active' %>
                                        </button>
                                    <% } %>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-8">
                                <div class="border-b border-gray-200 px-6 py-4 flex justify-between items-center">
                                    <h2 class="text-lg font-medium text-gray-900">Your Cards</h2>
                                    <% if (stats.pendingCount === 0 && stats.activeCount === 0) { %>
                                        <a href="/apply" class="text-sm text-primary-600 hover:text-primary-800 flex items-center">
                                            <i data-lucide="plus-circle" class="h-4 w-4 mr-1"></i> New Card
                                        </a>
                                    <% } %>
                                </div>
                                <div class="divide-y divide-gray-200">
                                    <% cards.forEach(card => { %>
                                        <div 
                                            class="p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 hover:bg-gray-50 transition cursor-pointer"
                                            @click="selectedCard = { 
                                                cardType: '<%= card.cardType %>', 
                                                cardNumber: '<%= card.cardNumber %>', 
                                                cardHolderName: '<%= card.cardHolderName %>', 
                                                expiryDate: '<%= card.expiryDate %>', 
                                                cvv: '<%= card.cvv %>', 
                                                currency: '<%= card.currency %>', 
                                                balance: '<%= card.balance.toFixed(2) %>',
                                                status: '<%= card.status %>'
                                            }; cardModalOpen = true; cardFlipped = false;"
                                        >
                                            <div class="flex items-center">
                                                <div class="h-14 w-20 bg-gradient-to-br from-gray-800 to-gray-900 rounded-lg flex items-center justify-center text-white font-mono text-lg font-bold shadow-inner">
                                                    <%= card.cardType.toUpperCase() %>
                                                </div>
                                                <div class="ml-5">
                                                    <p class="font-semibold text-gray-900"><%= card.cardHolderName %></p>
                                                    <p class="text-sm text-gray-500 font-mono">
                                                        •••• •••• •••• <%= card.cardNumber.slice(-4) %>
                                                    </p>
                                                    <p class="text-xs text-gray-400 mt-1">
                                                        Expires <%= card.expiryDate %>
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="text-right">
                                                <p class="text-2xl font-bold text-gray-900">
                                                    <%= card.currency %> <%= card.balance.toFixed(2) %>
                                                </p>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium mt-2
                                                    <%= card.status === 'active' ? 'bg-green-100 text-green-800' : 
                                                        card.status === 'pending' ? 'bg-yellow-100 text-yellow-800' : 
                                                        'bg-gray-100 text-gray-800' %>">
                                                    <%= card.status.charAt(0).toUpperCase() + card.status.slice(1) %>
                                                </span>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>

                        <!-- How It Works -->
                        <div class="mb-8">
                            <h2 class="text-xl font-bold text-gray-900 mb-6">How Virtual Cards Work</h2>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
                                    <div class="flex items-center justify-center h-12 w-12 rounded-full bg-primary-100 mb-4">
                                        <i data-lucide="file-text" class="h-6 w-6 text-gray-600"></i>
                                    </div>
                                    <h3 class="text-lg font-medium text-gray-900 mb-2">1. Apply</h3>
                                    <p class="text-gray-600">Complete the application form for your virtual card. Select your preferred card type and set your spending limits.</p>
                                </div>
                                <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
                                    <div class="flex items-center justify-center h-12 w-12 rounded-full bg-primary-100 mb-4">
                                        <i data-lucide="check-circle" class="h-6 w-6 text-gray-600"></i>
                                    </div>
                                    <h3 class="text-lg font-medium text-gray-900 mb-2">2. Activate</h3>
                                    <p class="text-gray-600">Once approved, your virtual card will be ready to use. View the card details and activate it from your dashboard.</p>
                                </div>
                                <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
                                    <div class="flex items-center justify-center h-12 w-12 rounded-full bg-primary-100 mb-4">
                                        <i data-lucide="shopping-cart" class="h-6 w-6 text-gray-600"></i>
                                    </div>
                                    <h3 class="text-lg font-medium text-gray-900 mb-2">3. Use</h3>
                                    <p class="text-gray-600">Use your virtual card for online transactions anywhere major credit cards are accepted. Monitor transactions in real-time.</p>
                                </div>
                            </div>
                        </div>

                        <!-- FAQ -->
                        <div class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-100">
                            <div class="border-b border-gray-200 px-6 py-4">
                                <h2 class="text-lg font-medium text-gray-900">Frequently Asked Questions</h2>
                            </div>
                            <div class="p-6">
                                <dl class="space-y-6">
                                    <div>
                                        <dt class="text-base font-medium text-gray-900">What is a virtual card?</dt>
                                        <dd class="mt-2 text-sm text-gray-600">A virtual card is a digital payment card that can be used for online transactions. It works just like a physical card but exists only in digital form, providing enhanced security for online purchases.</dd>
                                    </div>
                                    <div>
                                        <dt class="text-base font-medium text-gray-900">How secure are virtual cards?</dt>
                                        <dd class="mt-2 text-sm text-gray-600">Virtual cards offer additional security as they're separate from your primary account. You can create cards with specific spending limits and even create single-use cards for enhanced protection against fraud.</dd>
                                    </div>
                                    <div>
                                        <dt class="text-base font-medium text-gray-900">Can I have multiple virtual cards?</dt>
                                        <dd class="mt-2 text-sm text-gray-600">Yes, you can apply for multiple virtual cards for different purposes - such as one for subscriptions, another for shopping, etc. Each card can have its own limits and settings.</dd>
                                    </div>
                                    <div>
                                        <dt class="text-base font-medium text-gray-900">How long does it take to get a virtual card?</dt>
                                        <dd class="mt-2 text-sm text-gray-600">Virtual cards are typically issued within minutes after approval. Once approved, you can immediately view and use the card details for online transactions.</dd>
                                    </div>
                                </dl>
                            </div>
                        </div>

                    </div>
                </div>
            </main>

            <!-- Footer -->
            <footer class="bg-white border-t border-gray-200 hidden md:block">
                <div class="max-w-7xl mx-auto py-4 px-4 sm:px-6 md:flex md:items-center md:justify-between">
                    <div class="flex items-center">
                        <img src="storage/app/public/photos/I98wEMilPMHkNy8wxBtJ86dmMTWl2kK4kkPJNI9l.png" alt="Logo" class="h-6 w-auto mr-2">
                        <p class="text-sm text-gray-500">© 2026 swiftcaptial. All rights reserved.</p>
                    </div>
                    <div class="flex space-x-6 mt-4 md:mt-0">
                        <a href="#" class="text-sm text-gray-500 hover:text-gray-700">Privacy Policy</a>
                        <a href="#" class="text-sm text-gray-500 hover:text-gray-700">Terms of Service</a>
                        <a href="/support" class="text-sm text-gray-500 hover:text-gray-700">Contact Support</a>
                    </div>
                </div>
            </footer>
        </div>

        <!-- Card Detail Modal -->
        <div 
            x-show="cardModalOpen" 
            class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-80 backdrop-blur-sm p-4"
            @click="cardModalOpen = false"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
        >
            <div 
                @click.stop 
                class="relative max-w-lg w-full"
                x-transition:enter="transition ease-out duration-300 transform"
                x-transition:enter-start="scale-95 opacity-0"
                x-transition:enter-end="scale-100 opacity-100"
                x-transition:leave="transition ease-in duration-200 transform"
                x-transition:leave-start="scale-100 opacity-100"
                x-transition:leave-end="scale-95 opacity-0"
            >
                <!-- Close button -->
                <button 
                    @click="cardModalOpen = false" 
                    class="absolute -top-12 right-0 text-white hover:text-gray-300 z-10"
                >
                    <i data-lucide="x-circle" class="h-8 w-8"></i>
                </button>

                <!-- Credit Card Container -->
                <div 
                    class="credit-card"
                    :class="{ 'card-flipped': cardFlipped }"
                >
                    <div class="card-inner">
                        <!-- Front -->
                        <div class="card-face card-front">
                            <div class="card-logo">swiftcaptial</div>
                            <div class="chip"></div>
                            <div class="card-number" x-text="selectedCard?.cardNumber?.replace(/(\d{4})(\d{4})(\d{4})(\d{4})/, '$1 $2 $3 $4') || '•••• •••• •••• ••••'"></div>

                            <!-- Bottom row: holder name + expiry in straight line -->
                            <div class="card-bottom-row">
                                <div class="card-holder-section">
                                    <div class="card-holder-label">CARDHOLDER</div>
                                    <div class="holder-name" x-text="selectedCard?.cardHolderName || 'FULL NAME'"></div>
                                </div>
                                <div class="card-expiry-section text-right">
                                    <div class="card-expiry-label">EXPIRES END</div>
                                    <div class="expiry-date" x-text="selectedCard?.expiryDate || 'MM/YY'"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Back -->
                        <div class="card-face card-back">
                            <div class="magnetic-stripe"></div>
                            <div class="signature-panel relative">
                                <div class="cvv-box" x-text="selectedCard?.cvv || '***'"></div>
                            </div>
                            <div class="issuer-text">
                                For customer service call +1-XXX-XXXXXXX<br>
                                or visit www.swiftcaptial.com
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Flip Button -->
                <div class="text-center mt-8">
                    <button 
                        @click="cardFlipped = !cardFlipped"
                        class="inline-flex items-center px-8 py-4 bg-gray-900 text-white text-lg font-medium rounded-xl hover:bg-gray-800 transition shadow-lg"
                    >
                        <span x-show="!cardFlipped">Show Back (CVV & Signature)</span>
                        <span x-show="cardFlipped">Show Front</span>
                        <i data-lucide="refresh-cw" class="h-6 w-6 ml-3"></i>
                    </button>
                </div>
            </div>
        </div>

    </div>

    <script>
document.getElementById('current-date').textContent = 
    new Date().toLocaleDateString('en-US', { 
        weekday: 'long', 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric' 
    });
</script>

    <!-- Scripts -->
    <script>
        lucide.createIcons();

        window.onload = function() {
            const preloader = document.querySelector('.page-loading');
            setTimeout(() => {
                preloader.classList.remove('active');
                setTimeout(() => preloader.remove(), 500);
            }, 800);
        };

        // Swap balance function
        async function swapBalance() {
            const { value: amount } = await Swal.fire({
                title: 'Transfer to Main Balance',
                input: 'number',
                inputLabel: 'Amount to transfer',
                inputValue: '<%= stats.totalCardBalance %>',
                inputAttributes: {
                    min: '0.01',
                    max: '<%= stats.totalCardBalance %>',
                    step: '0.01'
                },
                showCancelButton: true,
                confirmButtonText: 'Transfer',
                confirmButtonColor: '#0ea5e9',
                preConfirm: (val) => {
                    if (!val || val <= 0) {
                        Swal.showValidationMessage('Please enter a valid amount');
                        return false;
                    }
                    return val;
                }
            });

            if (!amount) return;

            Swal.fire({
                title: 'Processing...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const res = await fetch('/cards/swap-balance', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ amount: parseFloat(amount) })
                });

                const data = await res.json();

                if (!data.success) {
                    throw new Error(data.message || 'Transfer failed');
                }

                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: 'Balance transferred successfully.',
                    timer: 2000,
                    showConfirmButton: false
                }).then(() => {
                    location.reload();
                });

            } catch (err) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: err.message || 'Failed to transfer balance. Please try again.',
                    confirmButtonColor: '#0ea5e9'
                });
            }
        }
    </script>

</body>
</html>