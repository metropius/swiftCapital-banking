<script>
document.getElementById('cardApplyForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    const submitBtn = document.getElementById('submitBtn');
    const originalText = submitBtn.innerHTML;

    // Disable button & show loading
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i data-lucide="loader-2" class="h-5 w-5 mr-2 animate-spin"></i> Submitting...';

    const formData = new FormData(this);

    try {
        const response = await fetch('/apply', {
            method: 'POST',
            body: formData,
            headers: {
                'Accept': 'application/json'
                // Do NOT set Content-Type → browser sets multipart/form-data automatically
            }
        });

        const result = await response.json();

        if (result.success) {
            Swal.fire({
                icon: 'success',
                title: 'Application Submitted!',
                text: result.message || 'Your virtual card application has been received and is under review.',
                allowOutsideClick: false,
                confirmButtonColor: '#0ea5e9'
            }).then(() => {
                window.location.href = '/cards';
            });
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                html: result.message || 'Please check the form and try again.',
                confirmButtonColor: '#0ea5e9'
            });
        }
    } catch (err) {
        Swal.fire({
            icon: 'error',
            title: 'Network Error',
            text: 'Could not connect to the server. Please check your internet connection.',
            confirmButtonColor: '#0ea5e9'
        });
    } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
        lucide.createIcons(); // re-init icons if needed
    }
});
</script>
    
    <!-- Enhanced Page Loading Animation -->
    <script>
