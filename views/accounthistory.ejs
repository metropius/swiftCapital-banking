                        <a href="/accounthistory/<%= user._id %>" class="flex flex-col items-center">...</a>
                        <div class="absolute left-1/2 transform -translate-x-1/2 -translate-y-1/2 top-0">
                            <button @click="mobileMenuOpen = true" class="bg-gradient-to-r from-primary-600 to-primary-800 w-16 h-16 rounded-full flex items-center justify-center shadow-lg border-4 border-white">
                                <i data-lucide="grid" class="h-8 w-8 text-white"></i>
                            </button>
                        </div>
                        <a href="/cards" class="flex flex-col items-center">...</a>
                        <a href="/account-settings" class="flex flex-col items-center">...</a>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <main class="flex-1 overflow-y-auto pb-16 md:pb-0">
                <div class="py-6">
                    <div class="max-w-8xl mx-auto px-4 sm:px-6 md:px-8">

                        <!-- Page Header -->
                        <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
                            <div>
                                <h1 class="text-2xl font-bold text-gray-900 mb-1">Transactions</h1>
                                <div class="flex items-center text-sm text-gray-500">
                                    <a href="/dashboard" class="hover:text-primary-600">Dashboard</a>
                                    <i data-lucide="chevron-right" class="h-4 w-4 mx-2"></i>
                                    <span class="font-medium text-gray-700">Transactions</span>
                                </div>
                            </div>
                            <div class="flex mt-4 md:mt-0 space-x-3">
                                <button @click="showFilterModal = true" class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50">
                                    <i data-lucide="filter" class="h-4 w-4 mr-2"></i> Filter
                                </button>
                                <button @click="showExportModal = true" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-lg text-white bg-primary-600 hover:bg-primary-700">
                                    <i data-lucide="download" class="h-4 w-4 mr-2"></i> Export
                                </button>
                            </div>
                        </div>

                        <!-- Search Bar -->
                        <div class="mb-6">
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i data-lucide="search" class="h-5 w-5 text-gray-400"></i>
                                </div>
                                <input type="search" x-model="search" class="block w-full pl-10 pr-3 py-3 border border-gray-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all" placeholder="Search by transaction reference..." />
                            </div>
                        </div>

                        <!-- Transactions Table -->
                        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                            <div class="overflow-x-auto">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-50">
                                        <tr>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"></th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reference ID</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Scope</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody class="bg-white divide-y divide-gray-200">

                                        <!-- Deposits (Credit) -->
                                        <% user.deposits.forEach(deposit => { %>
                                            <tr class="hover:bg-gray-50 transition-colors">
                                                <td class="px-6 py-4 whitespace-nowrap">
                                                    <div class="h-10 w-10 bg-green-100 rounded-full flex items-center justify-center">
                                                        <i data-lucide="plus" class="h-5 w-5 text-green-600"></i>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap">
                                                    <div class="text-sm font-medium text-gray-900">
                                                        <%= user.currency %> <%= deposit.amount %>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap">
                                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                                        Credit
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap">
                                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                                        <%= deposit.status === 'approved' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                                                        <%= deposit.status.charAt(0).toUpperCase() + deposit.status.slice(1) %>
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono">
                                                    <%= deposit._id %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                                    <%= deposit.narration || 'Deposit' %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                                    <%= deposit.type.charAt(0).toUpperCase() + deposit.type.slice(1) %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                                    <%= new Date(deposit.createdAt).toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                                    <button onclick="showDepositModal('<%= deposit._id %>', '<%= deposit.type %>', '<%= deposit.amount %>', '<%= deposit.status %>', '<%= deposit.narration || 'Deposit' %>', '<%= deposit.createdAt %>')"
                                                            class="text-primary-600 hover:text-primary-900">
                                                        Receipt
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }) %>

                                        <!-- Transfers (Debit) -->
                                        <% user.transfers.forEach(transfer => { %>
                                            <tr class="hover:bg-gray-50 transition-colors">
                                                <td class="px-6 py-4 whitespace-nowrap">
                                                    <div class="h-10 w-10 bg-red-100 rounded-full flex items-center justify-center">
                                                        <i data-lucide="minus" class="h-5 w-5 text-red-600"></i>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap">
                                                    <div class="text-sm font-medium text-gray-900">
                                                        <%= user.currency %> <%= transfer.amount %>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap">
                                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                                                        Debit
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap">
                                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                                        <%= transfer.status === 'approved' ? 'bg-green-100 text-green-800' : 
                                                            transfer.status === 'pending' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800' %>">
                                                        <%= transfer.status.charAt(0).toUpperCase() + transfer.status.slice(1) %>
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono">
                                                    <%= transfer._id %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                                    <%= transfer.note || transfer.type %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                                    <%= transfer.type %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                                    <%= new Date(transfer.createdAt).toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                                    <button onclick="showTransferModal('<%= transfer._id %>', '<%= transfer.type %>', '<%= transfer.amount %>', '<%= transfer.status %>', '<%= transfer.note || 'No note' %>', '<%= transfer.createdAt %>', '<%= transfer.transferFrom %>')"
                                                            class="text-primary-600 hover:text-primary-900">
                                                        Receipt
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }) %>

                                        <!-- Empty state -->
                                        <% if (user.deposits.length === 0 && user.transfers.length === 0) { %>
                                            <tr>
                                                <td colspan="9" class="px-6 py-12 text-center text-gray-500">
                                                    <i data-lucide="history" class="mx-auto h-12 w-12 text-gray-400"></i>
                                                    <p class="mt-2 text-sm">No transactions found</p>
                                                </td>
                                            </tr>
                                        <% } %>

                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Modals -->
                        <div id="depositModal" class="fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center z-50 hidden">
                            <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full mx-4 overflow-hidden">
                                <div class="bg-gradient-to-r from-green-600 to-green-700 px-6 py-5 text-white">
                                    <h3 class="text-xl font-bold">Deposit Receipt</h3>
                                    <p class="text-white/90 mt-1 text-sm">Transaction Details</p>
                                </div>
                                <div class="p-6 space-y-4" id="depositModalContent"></div>
                                <div class="px-6 py-4 bg-gray-50 flex justify-end">
                                    <button onclick="document.getElementById('depositModal').classList.add('hidden')" 
                                            class="px-5 py-2.5 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition">
                                        Close
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div id="transferModal" class="fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center z-50 hidden">
                            <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full mx-4 overflow-hidden">
                                <div class="bg-gradient-to-r from-red-600 to-red-700 px-6 py-5 text-white">
                                    <h3 class="text-xl font-bold">Transfer Receipt</h3>
                                    <p class="text-white/90 mt-1 text-sm">Transaction Details</p>
                                </div>
                                <div class="p-6 space-y-4" id="transferModalContent"></div>
                                <div class="px-6 py-4 bg-gray-50 flex justify-end">
                                    <button onclick="document.getElementById('transferModal').classList.add('hidden')" 
                                            class="px-5 py-2.5 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition">
                                        Close
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </main>

            <!-- Footer -->
            <footer class="bg-white border-t border-gray-200 hidden md:block">
                <div class="max-w-7xl mx-auto py-4 px-4 sm:px-6 md:flex md:items-center md:justify-between">
                    <div class="flex items-center">
                        <img src="/storage/app/public/photos/I98wEMilPMHkNy8wxBtJ86dmMTWl2kK4kkPJNI9l.png" alt="Logo" class="h-6 w-auto mr-2">
                        <p class="text-sm text-gray-500">© 2026 swiftcaptial. All rights reserved.</p>
                    </div>
                    <div class="flex space-x-6 mt-4 md:mt-0">
                        <a href="#" class="text-sm text-gray-500 hover:text-gray-700">Privacy Policy</a>
                        <a href="#" class="text-sm text-gray-500 hover:text-gray-700">Terms of Service</a>
                        <a href="/support" class="text-sm text-gray-500 hover:text-gray-700">Contact Support</a>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- JavaScript: Flash messages + Modal functions + Lucide + Loader -->
    <script>
        // ─── Flash Messages & Transfer Success Alert ────────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
            <% if (messages.success && messages.success.length) { %>
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: '<%= messages.success %>',
                    timer: 5000,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            <% } %>

            <% if (messages.error && messages.error.length) { %>
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: '<%= messages.error %>',
                    confirmButtonColor: '#ef4444'
                });
            <% } %>

            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('transfer_success') === '1') {
                Swal.fire({
                    icon: 'success',
                    title: 'Transfer Submitted!',
                    text: 'Your transfer has been successfully submitted and is awaiting approval.',
                    timer: 4500,
                    showConfirmButton: false,
                    toast: false,
                    position: 'center'
                });
                window.history.replaceState({}, document.title, window.location.pathname);
            }

            // ─── Modal Functions (moved here so they are defined before onclick) ───
            window.showDepositModal = function(id, type, amount, status, narration, createdAt) {
                const content = `
                    <div class="space-y-3">
                        <div class="flex justify-between">
                            <span class="text-gray-600">Reference ID</span>
                            <span class="font-medium font-mono">${id}</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Type</span>
                            <span class="font-medium">${type.charAt(0).toUpperCase() + type.slice(1)}</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Amount</span>
                            <span class="font-bold text-green-600"><%= user.currency %> ${amount}</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Status</span>
                            <span class="px-2 py-1 rounded-full text-xs font-semibold
                                ${status === 'approved' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'}">
                                ${status.charAt(0).toUpperCase() + status.slice(1)}
                            </span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Narration</span>
                            <span class="font-medium">${narration}</span>
                        </div>
                        <div class="flex justify-between pt-3 border-t">
                            <span class="text-gray-600">Date</span>
                            <span class="font-medium">${new Date(createdAt).toLocaleString()}</span>
                        </div>
                    </div>
                `;
                document.getElementById('depositModalContent').innerHTML = content;
                document.getElementById('depositModal').classList.remove('hidden');
            };

            window.showTransferModal = function(id, type, amount, status, note, createdAt, transferFrom) {
                const content = `
                    <div class="space-y-3">
                        <div class="flex justify-between">
                            <span class="text-gray-600">Reference ID</span>
                            <span class="font-medium font-mono">${id}</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Type</span>
                            <span class="font-medium">${type}</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Amount</span>
                            <span class="font-bold text-red-600"><%= user.currency %> ${amount}</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Status</span>
                            <span class="px-2 py-1 rounded-full text-xs font-semibold
                                ${status === 'approved' ? 'bg-green-100 text-green-800' : 
                                  status === 'pending' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800'}">
                                ${status.charAt(0).toUpperCase() + status.slice(1)}
                            </span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Note</span>
                            <span class="font-medium">${note}</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Source</span>
                            <span class="font-medium uppercase">${transferFrom}</span>
                        </div>
                        <div class="flex justify-between pt-3 border-t">
                            <span class="text-gray-600">Date</span>
                            <span class="font-medium">${new Date(createdAt).toLocaleString()}</span>
                        </div>
                    </div>
                `;
                document.getElementById('transferModalContent').innerHTML = content;
                document.getElementById('transferModal').classList.remove('hidden');
            };

            // Close modals when clicking outside content
            document.addEventListener('click', function(e) {
                if (e.target.id === 'depositModal' || e.target.id === 'transferModal') {
                    e.target.classList.add('hidden');
                }
            });
        });

        // Lucide Icons
        lucide.createIcons();

        // Page Loader
        window.addEventListener('load', function() {
            const preloader = document.querySelector('.page-loading');
            setTimeout(() => {
                preloader.classList.remove('active');
                setTimeout(() => preloader.remove(), 500);
            }, 800);
        });

        // Date and Time Updates (unchanged)
        function updateDate() {
           document.getElementById('current-date').textContent = 
    new Date().toLocaleDateString('en-US', { 
        weekday: 'long', 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric' 
    });
        }
        updateDate();
     
    </script>
</body>
</html>