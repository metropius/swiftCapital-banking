        body {font-family:"Graphik",sans-serif;}

        .page-loading{position:fixed;top:0;right:0;bottom:0;left:0;width:100%;height:100%;background:#fff;visibility:hidden;z-index:9999;transition:all .4s .2s ease-in-out}
        .page-loading.active{opacity:1;visibility:visible}
        .page-loading-inner{position:absolute;top:50%;left:0;width:100%;text-align:center;transform:translateY(-50%);transition:opacity .2s ease-in-out;opacity:0}
        .page-loading.active>.page-loading-inner{opacity:1}
        .loading-container{display:flex;align-items:center;justify-content:center;flex-direction:column}
        .loading-animation{display:flex;align-items:center;justify-content:center;width:80px;height:80px;margin-bottom:1rem;position:relative}
        .loading-animation .circle{position:absolute;width:100%;height:100%;border-radius:50%;border:4px solid transparent;mix-blend-mode:overlay;animation:rotateCircle 1.5s linear infinite}
        .loading-animation .circle:nth-child(1){border-top-color:var(--primary-color);animation-delay:0s}
        .loading-animation .circle:nth-child(2){border-right-color:var(--primary-color-light);animation-delay:.2s}
        .loading-animation .circle:nth-child(3){border-bottom-color:var(--secondary-color);animation-delay:.4s}
        .loading-animation .circle:nth-child(4){border-left-color:var(--primary-color-lightest);animation-delay:.6s}
        .loading-animation .core{width:20px;height:20px;border-radius:50%;background:linear-gradient(45deg,var(--primary-color-light),var(--primary-color-dark));box-shadow:0 0 15px rgba(59,130,246,.5);animation:pulse 1s ease-in-out infinite alternate}
        .page-loading .text{color:var(--primary-color);font-weight:500;letter-spacing:.05em;margin-top:.5rem;font-size:.875rem;background:linear-gradient(90deg,var(--primary-color-dark),var(--primary-color-light),var(--primary-color-dark));background-size:200% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:gradient 2s linear infinite}
        @keyframes rotateCircle{0%{transform:rotate(0deg)}100%{transform:rotate(360deg)}}
        @keyframes pulse{from{transform:scale(.8);opacity:.8}to{transform:scale(1.2);opacity:1}}
        @keyframes gradient{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
        ::-webkit-scrollbar{width:8px;height:8px}
        ::-webkit-scrollbar-track{background:#f1f5f9}
        ::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px}
        ::-webkit-scrollbar-thumb:hover{background:#94a3b8}

        /* OTP input styling */
        .otp-input:focus {
            border-color: #0ea5e9;
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.2);
            outline: none;
        }
        .otp-input::-webkit-outer-spin-button,
        .otp-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
    </style>

