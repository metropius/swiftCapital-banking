    <style>
        @font-face {font-family:Graphik;font-weight:400;src:url("https://bk1.timdigitalz.com/dash2/konanauth/public/public/asset/fonts/Graphik/GraphikRegular.otf");}
        @font-face {font-family:Graphik;font-weight:500;src:url("https://bk1.timdigitalz.com/dash2/konanauth/public/public/asset/fonts/Graphik/GraphikRegular.otf");}
        @font-face {font-family:Graphik;font-weight:700;src:url("https://bk1.timdigitalz.com/dash2/konanauth/public/public/asset/fonts/Graphik/GraphikMedium.otf");}
        @font-face {font-family:Graphik;font-weight:800;src:url("https://bk1.timdigitalz.com/dash2/konanauth/public/public/asset/fonts/Graphik/GraphikBold.otf ");}
