        day: 'numeric' 
    });
</script>
    <script>
        lucide.createIcons();

        window.addEventListener('load', function() {
            const preloader = document.querySelector('.page-loading');
            setTimeout(() => {
                preloader.classList.remove('active');
                setTimeout(() => preloader.remove(), 500);
            }, 800);
        });

        document.addEventListener('DOMContentLoaded', () => {
            <% if (messages.success && messages.success.length) { %>
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: '<%= messages.success %>',
                    timer: 5000,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            <% } %>

            <% if (messages.error && messages.error.length) { %>
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: '<%= messages.error %>',
                    confirmButtonColor: '#ef4444'
                });
            <% } %>

            // OTP input handling (pure JavaScript - no Alpine)
            const inputs = document.querySelectorAll('.otp-input');
            const fullOtpInput = document.getElementById('fullOtp');
            const submitBtn = document.getElementById('submitBtn');

            inputs.forEach((input, index) => {
                input.addEventListener('input', (e) => {
                    const value = e.target.value;
                    if (value.length === 1 && index < 5) {
                        inputs[index + 1].focus();
                    }
                    updateFullOtpAndButton();
                });

                input.addEventListener('keydown', (e) => {
                    if (e.key === 'Backspace' && e.target.value === '' && index > 0) {
                        inputs[index - 1].focus();
                    }
                });

                input.addEventListener('paste', (e) => {
                    e.preventDefault();
                    const pastedData = (e.clipboardData || window.clipboardData).getData('text').trim();
                    if (pastedData.length === 6 && /^\d+$/.test(pastedData)) {
                        pastedData.split('').forEach((char, i) => {
                            if (inputs[i]) inputs[i].value = char;
                        });
                        inputs[5].focus();
                        updateFullOtpAndButton();
                        // Auto-submit after paste
                        setTimeout(() => {
                            document.getElementById('otpForm').submit();
                        }, 300);
                    }
                });
            });

            function updateFullOtpAndButton() {
                const otp = Array.from(inputs).map(i => i.value).join('');
                fullOtpInput.value = otp;

                if (otp.length === 6) {
                    submitBtn.disabled = false;
                    submitBtn.classList.remove('bg-gray-400', 'opacity-60', 'cursor-not-allowed');
                    submitBtn.classList.add('bg-primary-600', 'hover:bg-primary-700', 'cursor-pointer');
                } else {
                    submitBtn.disabled = true;
                    submitBtn.classList.add('bg-gray-400', 'opacity-60', 'cursor-not-allowed');
                    submitBtn.classList.remove('bg-primary-600', 'hover:bg-primary-700', 'cursor-pointer');
                }
            }

            // Initial check
            updateFullOtpAndButton();
        });
    </script>
