                      <div x-data="{ 
    amount: '', 
    transferFrom: 'usd',
    accountname: '',
    accountnumber: '',
    bankname: '',
    Accounttype: 'Online Banking',
    pin: '',
    Description: '',
    isSubmitting: false,
    showPreview: false,
    accountLookupStatus: '', // 'loading' | 'found' | 'notfound' | ''
    lookupTimer: null,

    get currentBalance() {
        return this.transferFrom === 'btc' 
            ? <%= user.btcBalance || 0 %> 
            : <%= user.balance || 0 %>;
    },
    
    validateAmount() {
        const max = this.currentBalance;
        if (parseFloat(this.amount) > max) this.amount = max.toString();
    },

    async lookupAccount() {
        if (this.transferFrom !== 'usd') {
            this.accountname = '';
            this.accountLookupStatus = '';
            return;
        }
        clearTimeout(this.lookupTimer);
        const acc = this.accountnumber.trim();
        if (!acc || acc.length < 6) {
            this.accountname = '';
            this.accountLookupStatus = '';
            return;
        }
        this.accountLookupStatus = 'loading';
        this.lookupTimer = setTimeout(async () => {
            try {
                const res = await fetch(`/check-account-number?accountnumber=${encodeURIComponent(acc)}`);
                const data = await res.json();
                if (data.found) {
                    this.accountname = data.name;
                    this.accountLookupStatus = 'found';
                } else {
                    this.accountname = '';
                    this.accountLookupStatus = 'notfound';
                }
            } catch (e) {
                this.accountname = '';
                this.accountLookupStatus = 'notfound';
            }
        }, 450);
    },

    async submitForm() {
        if (this.isSubmitting) return;
        if (this.transferFrom === 'usd' && this.accountLookupStatus !== 'found') {
            Swal.fire({
                icon: 'error',
                title: 'Invalid Account',
                text: 'Please enter a valid account number that exists in our system.'
            });
            return;
        }
        this.isSubmitting = true;

        const formData = new FormData();
        formData.append('amount', this.amount);
        formData.append('transferFrom', this.transferFrom);
        formData.append('accountname', this.accountname);
        formData.append('accountnumber', this.accountnumber);
        formData.append('bankname', this.bankname || 'Internal');
        formData.append('Accounttype', this.Accounttype);
        formData.append('Description', this.Description);
        formData.append('pin', this.pin);

        try {
            const response = await fetch('/localtransfer/<%= user._id %>', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (response.ok && result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Transfer Initiated',
                    text: 'OTP has been sent to your email.',
                    timer: 4000,
                    showConfirmButton: false
                }).then(() => {
                    window.location.href = `/verify-transfer-otp/<%= user._id %>`;
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    html: result.message || 'Failed to initiate transfer. Please try again.'
                });
            }
        } catch (err) {
            Swal.fire({
                icon: 'error',
                title: 'Connection Error',
                text: 'Could not connect to the server. Please check your internet connection.'
            });
        } finally {
            this.isSubmitting = false;
        }
    }
}">
